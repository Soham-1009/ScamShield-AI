# ScamShield AI — Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env to version control.

# Flask Server Binding
SCAMSHIELD_HOST=127.0.0.1
SCAMSHIELD_PORT=5000
SCAMSHIELD_DEBUG=false

# Dataset & Model Artifact Paths
SCAMSHIELD_DATASET_PATH=data/fake_job_postings.csv
SCAMSHIELD_MODEL_PATH=models/fake_job_model.joblib
SCAMSHIELD_MODEL_METADATA_PATH=models/model_metadata.json

# Optional Custom Tesseract Binary Path (Windows example)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Validation & Rate Limiting
SCAMSHIELD_MAX_TEXT_LENGTH=25000
SCAMSHIELD_MIN_TEXT_LENGTH=10
SCAMSHIELD_MAX_IMAGE_BYTES=5242880
SCAMSHIELD_RATE_LIMIT_PER_MINUTE=60

# Optional Strict CORS Origin for Production Chrome Extension ID
# SCAMSHIELD_CORS_ORIGIN=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
